rtk := env("RTK", "rustanka")

# Every directory under test/environments is a Tanka environment that must render.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    for env in test/environments/*; do
        echo "rtk show $env"
        {{ rtk }} show "$env" --dangerous-allow-redirect > /dev/null
    done

# Re-vendor the CRDs for a release, e.g. `just generate v1.6.3 experimental`
generate version channel="experimental":
    ./generate.sh {{ version }} {{ channel }}
